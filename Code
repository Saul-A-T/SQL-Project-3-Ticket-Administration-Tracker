-- Project 03: Ticket Administration Tracker
-- Database: SQLite
-- Run this entire file in SQLite. It resets only the four project tables below.

PRAGMA foreign_keys = ON;

DROP TABLE IF EXISTS ticket_events;
DROP TABLE IF EXISTS tickets;
DROP TABLE IF EXISTS staff;
DROP TABLE IF EXISTS departments;

CREATE TABLE departments (
    department_id INTEGER PRIMARY KEY,
    department_name TEXT NOT NULL UNIQUE
);

CREATE TABLE staff (
    staff_id INTEGER PRIMARY KEY,
    staff_name TEXT NOT NULL,
    department_id INTEGER NOT NULL REFERENCES departments(department_id),
    active INTEGER NOT NULL DEFAULT 1 CHECK (active IN (0, 1))
);

CREATE TABLE tickets (
    ticket_id INTEGER PRIMARY KEY,
    requester_name TEXT NOT NULL,
    department_id INTEGER NOT NULL REFERENCES departments(department_id),
    assigned_to INTEGER REFERENCES staff(staff_id),
    subject TEXT NOT NULL,
    priority TEXT NOT NULL CHECK (priority IN ('low', 'medium', 'high', 'urgent')),
    status TEXT NOT NULL CHECK (status IN ('open', 'in_progress', 'pending', 'resolved', 'closed')),
    created_at TEXT NOT NULL,
    due_at TEXT NOT NULL,
    resolved_at TEXT,
    CHECK (resolved_at IS NULL OR resolved_at >= created_at)
);

CREATE TABLE ticket_events (
    event_id INTEGER PRIMARY KEY,
    ticket_id INTEGER NOT NULL REFERENCES tickets(ticket_id),
    event_at TEXT NOT NULL,
    event_type TEXT NOT NULL CHECK (event_type IN ('created', 'assigned', 'status_changed', 'commented', 'resolved')),
    note TEXT NOT NULL
);

