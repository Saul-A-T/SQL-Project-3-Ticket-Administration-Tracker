-- 1. Current ticket queue with department and assignee names.
SELECT
    t.ticket_id,
    t.subject,
    d.department_name,
    COALESCE(s.staff_name, 'Unassigned') AS assignee,
    t.priority,
    t.status,
    t.created_at,
    t.due_at
FROM tickets AS t
JOIN departments AS d ON d.department_id = t.department_id
LEFT JOIN staff AS s ON s.staff_id = t.assigned_to
WHERE t.status IN ('open', 'in_progress', 'pending')
ORDER BY
    CASE t.priority WHEN 'urgent' THEN 1 WHEN 'high' THEN 2 WHEN 'medium' THEN 3 ELSE 4 END,
    t.due_at,
    t.ticket_id;

-- 2. Open workload per staff member, including staff with zero active tickets.
SELECT
    s.staff_name,
    d.department_name,
    COUNT(t.ticket_id) AS active_ticket_count
FROM staff AS s
JOIN departments AS d ON d.department_id = s.department_id
LEFT JOIN tickets AS t
    ON t.assigned_to = s.staff_id
   AND t.status IN ('open', 'in_progress', 'pending')
WHERE s.active = 1
GROUP BY s.staff_id, s.staff_name, d.department_name
ORDER BY active_ticket_count DESC, s.staff_name;

-- 3. Tickets past their deadline as of the sample reporting date (2026-03-24).
SELECT
    t.ticket_id,
    t.subject,
    d.department_name,
    COALESCE(s.staff_name, 'Unassigned') AS assignee,
    t.priority,
    t.due_at,
    CAST(julianday('2026-03-24 23:59:59') - julianday(t.due_at) AS INTEGER) AS days_past_due
FROM tickets AS t
JOIN departments AS d ON d.department_id = t.department_id
LEFT JOIN staff AS s ON s.staff_id = t.assigned_to
WHERE t.status IN ('open', 'in_progress', 'pending')
  AND t.due_at < '2026-03-24 23:59:59'
ORDER BY t.due_at, t.ticket_id;

-- 4. Ticket volume by department and current status.
SELECT
    d.department_name,
    t.status,
    COUNT(*) AS ticket_count
FROM tickets AS t
JOIN departments AS d ON d.department_id = t.department_id
GROUP BY d.department_name, t.status
ORDER BY d.department_name, ticket_count DESC, t.status;

-- 5. Average resolution time by department, in hours.
-- Resolved and closed tickets with a resolved_at timestamp are included.
SELECT
    d.department_name,
    COUNT(*) AS resolved_ticket_count,
    ROUND(AVG((julianday(t.resolved_at) - julianday(t.created_at)) * 24), 1) AS avg_resolution_hours
FROM tickets AS t
JOIN departments AS d ON d.department_id = t.department_id
WHERE t.status IN ('resolved', 'closed')
  AND t.resolved_at IS NOT NULL
GROUP BY d.department_id, d.department_name
ORDER BY avg_resolution_hours, d.department_name;

-- 6. Resolution performance by priority: resolved on time vs. late.
SELECT
    t.priority,
    COUNT(*) AS resolved_ticket_count,
    SUM(CASE WHEN t.resolved_at <= t.due_at THEN 1 ELSE 0 END) AS resolved_on_time,
    SUM(CASE WHEN t.resolved_at > t.due_at THEN 1 ELSE 0 END) AS resolved_late,
    ROUND(100.0 * SUM(CASE WHEN t.resolved_at <= t.due_at THEN 1 ELSE 0 END) / COUNT(*), 1) AS on_time_percent
FROM tickets AS t
WHERE t.status IN ('resolved', 'closed')
  AND t.resolved_at IS NOT NULL
GROUP BY t.priority
ORDER BY CASE t.priority WHEN 'urgent' THEN 1 WHEN 'high' THEN 2 WHEN 'medium' THEN 3 ELSE 4 END;

-- 7. Daily ticket intake compared with the previous day (window function).
WITH daily_intake AS (
    SELECT date(created_at) AS ticket_day, COUNT(*) AS tickets_created
    FROM tickets
    GROUP BY date(created_at)
)
SELECT
    ticket_day,
    tickets_created,
    LAG(tickets_created) OVER (ORDER BY ticket_day) AS previous_day_count,
    tickets_created - LAG(tickets_created) OVER (ORDER BY ticket_day) AS change_from_previous_day
FROM daily_intake
ORDER BY ticket_day;

-- 8. Find tickets that have no recorded assignment event.
-- Useful for spotting gaps between current ticket state and the event history.
SELECT
    t.ticket_id,
    t.subject,
    t.status,
    COALESCE(s.staff_name, 'Unassigned') AS current_assignee
FROM tickets AS t
LEFT JOIN staff AS s ON s.staff_id = t.assigned_to
WHERE NOT EXISTS (
    SELECT 1
    FROM ticket_events AS e
    WHERE e.ticket_id = t.ticket_id
      AND e.event_type = 'assigned'
)
ORDER BY t.ticket_id;
